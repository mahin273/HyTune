<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground Daemon & Notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Boot Apply -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Floating Monitor HUD -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- App Usage & Management -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".HyTuneApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyTune">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HyTune">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.HyTuneDaemonService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hardware optimization, CPU/GPU profile management, and thermal throttling protection" />
        </service>

        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings Tiles -->
        <service
            android:name=".integration.tile.ProfileQuickTileService"
            android:icon="@android:drawable/ic_menu_manage"
            android:label="HyTune Profile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".integration.tile.OverlayQuickTileService"
            android:icon="@android:drawable/ic_menu_view"
            android:label="FPS Overlay"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- App Widget -->
        <receiver
            android:name=".integration.widget.HyTuneWidgetProvider"
            android:label="HyTune Profile"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mahin.hytune.action.WIDGET_CYCLE_PROFILE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hytune_info" />
        </receiver>

        <!-- Tasker & External Automation Receiver -->
        <receiver
            android:name=".integration.receiver.HyTuneAutomationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mahin.hytune.action.APPLY_PROFILE" />
                <action android:name="com.mahin.hytune.action.TOGGLE_OVERLAY" />
                <action android:name="com.mahin.hytune.action.RESET_DISPLAY" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
